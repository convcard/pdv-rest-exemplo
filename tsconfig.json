{
  // Processo main / preload do Electron (Node.js) + tipos compartilhados.
  // As telas (Angular) usam o tsconfig.app.json.
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": ["src/electron/**/*", "src/shared/**/*", "*.ts", "*.mts"]
}
